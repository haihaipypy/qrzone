{
  "buildCommand": "STATIC_EXPORT=true yarn build",
  "installCommand": "yarn install",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/zh/",
      "status": 302
    }
  ],
  "rewrites": [
    {
      "source": "/_next/*",
      "destination": "/_next/:splat"
    },
    {
      "source": "/assets/*",
      "destination": "/assets/:splat"
    }
  ],
  "headers": [
    {
      "source": "/_next/static/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
